generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdItem {
  id             String         @id @default(uuid()) @db.Uuid
  campaignId     String         @db.Uuid
  previewImage   String?
  status         String         @default("PENDING") @db.VarChar(64)
  createdAt      DateTime       @default(now()) @db.Timestamp(0)
  itemBudget     Float          @default(0)
  postUrl        String
  ogDescription  String?
  ogTitle        String?
  reachGoal      Int            @default(0)
  targetAudience String?
  campaign       AgencyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model portfolio {
  id               Int       @id @default(autoincrement())
  title            String    @db.VarChar(255)
  description      String?
  image_url        String?
  type             String?   @db.VarChar(64)
  result           String?
  category         String?   @db.VarChar(64)
  cover_image_url  String?
  gallery_json     String?
  video_links_json String?
  role_summary     String?
  action_summary   String?
  tech_focus       String?
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @default(now()) @db.Timestamp(0)
}

model users {
  id       Int    @id @default(autoincrement())
  username String @unique(map: "username") @db.VarChar(255)
  password String @db.VarChar(255)
}

model Service {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(255)
  description String?
  icon        String?        @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamp(0)
  projects    Project[]
  templates   FormTemplate[]

  @@map("services")
}

/// Wizard JSON: steps[] with fields; versioned per service.
model FormTemplate {
  id             Int               @id @default(autoincrement())
  serviceId      Int               @map("service_id")
  version        Int
  schemaJson     Json              @map("schema_json")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  form_responses form_responses[]
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  snapshots      ProjectSnapshot[]

  @@unique([serviceId, version])
  @@index([serviceId])
  @@map("form_templates")
}

model Project {
  id                Int                    @id @default(autoincrement())
  title             String                 @db.VarChar(255)
  client_name       String                 @map("client_name") @db.VarChar(255)
  lifecycleStatus   ProjectLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  type              ProjectType            @default(CLIENT_SERVICES) @map("project_type")
  serviceId         Int?                   @map("service_id")
  /// Admin-only: JSON array of field keys that must be re-opened when NEEDS_REVISION
  revisionFieldKeys Json?                  @map("revision_field_keys")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  assets            Asset[]
  submission        OnboardingSubmission?
  service           Service?               @relation(fields: [serviceId], references: [id])
  tokens            SecureToken[]
  activityLogs      ActivityLog[]
  collaboratorNotes CollaboratorNote[]
  deliverables      Deliverable[]
  form_responses    form_responses?
  snapshot          ProjectSnapshot?
  portfolioProject  PortfolioProject?

  @@index([serviceId])
  @@index([lifecycleStatus])
  @@map("Project")
}

/// Locked copy of the form schema (+ optional field toggles) at project creation.
model ProjectSnapshot {
  id                 Int           @id @default(autoincrement())
  projectId          Int           @unique @map("project_id")
  formTemplateId     Int?          @map("form_template_id")
  templateVersion    Int?          @map("template_version")
  schemaSnapshotJson Json          @map("schema_snapshot_json")
  fieldOverridesJson Json?         @map("field_overrides_json")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  formTemplate       FormTemplate? @relation(fields: [formTemplateId], references: [id])
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_snapshots")
}

/// Append-only audit trail (immutability enforced in application layer).
model ActivityLog {
  id           Int               @id @default(autoincrement())
  projectId    Int               @map("project_id")
  actorRole    ActivityActorRole @map("actor_role")
  action       String            @db.VarChar(128)
  metadataJson Json?             @map("metadata_json")
  ipAddress    String?           @map("ip_address") @db.VarChar(45)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("activity_logs")
}

model Deliverable {
  id        Int                  @id @default(autoincrement())
  projectId Int                  @map("project_id")
  version   Int
  title     String?              @db.VarChar(255)
  fileUrl   String               @map("file_url")
  type      String               @db.VarChar(64)
  status    DeliverableStatus    @default(PENDING)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamp(0)
  comments  DeliverableComment[]
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type, version])
  @@index([projectId])
  @@map("deliverables")
}

model DeliverableComment {
  id            Int         @id @default(autoincrement())
  deliverableId Int         @map("deliverable_id")
  author        String      @db.VarChar(128)
  comment       String
  pinX          Float?      @map("pin_x")
  pinY          Float?      @map("pin_y")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
  @@map("deliverable_comments")
}

model CollaboratorNote {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  author    String   @db.VarChar(128)
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("collaborator_notes")
}

model OnboardingSubmission {
  id            Int     @id @default(autoincrement())
  projectId     Int     @unique
  step1_soul    String
  step2_market  String
  step3_visual  String
  step4_media   Json
  step5_summary String
  data          Json?
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SecureToken {
  id         String   @id @default(uuid())
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime @db.Timestamp(0)
  is_active  Boolean  @default(true)
  is_used    Boolean  @default(false)
  project_id Int
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("SecureToken")
}

model Asset {
  id        String   @id @default(uuid())
  projectId Int
  url       String
  file_name String?  @db.VarChar(255)
  file_type String?  @db.VarChar(128)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OsUser {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String       @unique
  role        SystemRole   @default(CLIENT)
  firstName   String
  lastName    String
  clientId    String?      @db.Uuid
  createdAt   DateTime     @default(now())
  os_campaign OsCampaign[]
  os_client   OsClient?    @relation(fields: [clientId], references: [id])

  @@map("os_user")
}

model OsClient {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName         String
  whatsappNumber      String
  accountManagerId    String?               @db.Uuid
  createdAt           DateTime              @default(now())
  os_campaign         OsCampaign[]
  os_campaign_request os_campaign_request[]
  os_user             OsUser[]
  wallets             OsWallet[]

  @@map("os_client")
}

model OsCampaign {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignRequestId   String              @unique @db.Uuid
  clientId            String              @db.Uuid
  accountManagerId    String?             @db.Uuid
  facebookAdId        String?             @unique
  executionState      ExecutionState      @default(DRAFT)
  totalLockedBudget   Decimal             @db.Decimal(12, 2)
  currentSpent        Decimal             @default(0.00) @db.Decimal(12, 2)
  remainingBudget     Decimal             @db.Decimal(12, 2)
  actualFacebookSpend Decimal             @default(0.00) @db.Decimal(12, 2)
  agencyMarginAmount  Decimal             @default(0.00) @db.Decimal(12, 2)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  os_user             OsUser?             @relation(fields: [accountManagerId], references: [id])
  os_campaign_request os_campaign_request @relation(fields: [campaignRequestId], references: [id], onDelete: Cascade)
  os_client           OsClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  os_campaign_event   os_campaign_event[]

  @@map("os_campaign")
}

model OsWallet {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String   @db.Uuid
  walletType String
  balance    Decimal  @default(0.00) @db.Decimal(12, 2)
  currency   String   @default("USD")
  updatedAt  DateTime @updatedAt
  client     OsClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, walletType])
  @@map("os_wallet")
}

model OsFinancialTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String   @db.Uuid
  type          String
  amount        Decimal  @db.Decimal(12, 2)
  referenceId   String?
  description   String
  performedById String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@map("os_financial_transaction")
}

model AgencyCampaign {
  id                  String            @id @db.Uuid
  clientId            String            @db.Uuid
  title               String            @db.VarChar(255)
  serviceType         String?           @db.VarChar(128)
  category            String?           @db.VarChar(128)
  status              CampaignStatus    @default(PENDING)
  totalClientPaid     Float             @default(0)
  actualPlatformSpend Float             @default(0)
  serviceFee          Float             @default(0)
  profitMargin        Float             @default(0)
  startDate           DateTime?         @db.Timestamp(0)
  endDate             DateTime?         @db.Timestamp(0)
  createdAt           DateTime          @default(now()) @db.Timestamp(0)
  updatedAt           DateTime          @db.Timestamp(0)
  serviceBlocks       Json?
  adItems             AdItem[]
  AgencyClient        AgencyClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  CampaignLog         CampaignLog[]
  CampaignMessage     CampaignMessage[]
  invoices            invoices[]

  @@index([clientId])
}

model AgencyClient {
  id                String              @id @db.Uuid
  token             String              @unique @db.Uuid
  name              String              @db.VarChar(255)
  logo              String?
  primaryContact    String              @db.VarChar(255)
  preferredCurrency String              @default("USD") @db.VarChar(10)
  preferredLang     String              @default("en") @db.VarChar(10)
  createdAt         DateTime            @default(now()) @db.Timestamp(0)
  totalRevenue      Float               @default(0)
  AgencyCampaign    AgencyCampaign[]
  invoices          invoices[]
  service_contracts service_contracts[]
}

model CampaignLog {
  id                String         @id @db.Uuid
  campaignId        String         @db.Uuid
  action            String         @db.VarChar(255)
  user              String         @default("SYSTEM") @db.VarChar(64)
  details           String?
  isVisibleToClient Boolean        @default(false)
  createdAt         DateTime       @default(now()) @db.Timestamp(0)
  AgencyCampaign    AgencyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignMessage {
  id             String         @id @db.Uuid
  campaignId     String         @db.Uuid
  sender         String         @db.VarChar(64)
  text           String
  createdAt      DateTime       @default(now()) @db.Timestamp(0)
  AgencyCampaign AgencyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model form_responses {
  id               String        @id @db.Uuid
  project_id       Int           @unique
  form_template_id Int?
  response_json    Json
  submitted_at     DateTime      @default(now()) @db.Timestamp(0)
  form_templates   FormTemplate? @relation(fields: [form_template_id], references: [id])
  Project          Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([form_template_id])
}

model invoices {
  id             String          @id @db.Uuid
  invoiceNumber  String          @unique @db.VarChar(32)
  clientId       String          @db.Uuid
  campaignId     String?         @db.Uuid
  amount         Float
  status         InvoiceStatus   @default(PENDING)
  description    String?
  paidAt         DateTime?       @db.Timestamp(0)
  dueAt          DateTime?       @db.Timestamp(0)
  createdAt      DateTime        @default(now()) @db.Timestamp(0)
  updatedAt      DateTime        @db.Timestamp(0)
  AgencyCampaign AgencyCampaign? @relation(fields: [campaignId], references: [id])
  AgencyClient   AgencyClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

model os_campaign_event {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String         @db.Uuid
  fromState   ExecutionState
  toState     ExecutionState
  changedBy   String
  reason      String?
  createdAt   DateTime       @default(now())
  os_campaign OsCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model os_campaign_request {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String              @db.Uuid
  facebookPostUrl   String
  clientGoal        String
  targetBudget      Decimal             @db.Decimal(12, 2)
  status            String
  createdAt         DateTime            @default(now())
  os_campaign       OsCampaign?
  os_client         OsClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  os_recommendation os_recommendation[]
}

model os_recommendation {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignRequestId   String              @db.Uuid
  suggestedBudget     Decimal             @db.Decimal(12, 2)
  agencyMarkupFee     Decimal             @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime            @default(now())
  os_campaign_request os_campaign_request @relation(fields: [campaignRequestId], references: [id], onDelete: Cascade)
}

model service_contracts {
  id           String       @id @db.Uuid
  clientId     String       @db.Uuid
  name         String       @db.VarChar(255)
  amount       Float        @default(0)
  renewsAt     DateTime     @db.Timestamp(0)
  autoRenew    Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now()) @db.Timestamp(0)
  updatedAt    DateTime     @db.Timestamp(0)
  AgencyClient AgencyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([renewsAt])
}

enum ProjectLifecycleStatus {
  DRAFT
  SENT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED
  COMPLETED
}

enum ProjectType {
  CLIENT_SERVICES
  VISUAL_ID
  PROPOSAL
}

enum ActivityActorRole {
  ADMIN
  CLIENT
  SYSTEM
}

enum DeliverableStatus {
  PENDING
  APPROVED
  REVISION
}

enum CampaignStatus {
  PENDING
  FUNDED
  ACTIVE
  PAUSED
  COMPLETED
}

enum ExecutionState {
  DRAFT
  PENDING_REVIEW
  AWAITING_APPROVAL
  AWAITING_FUNDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum SystemRole {
  ADMIN
  STAFF
  CLIENT
}

enum PortfolioBridgeStatus {
  DRAFT
  PUBLISHED
}

model PortfolioProject {
  id             String                 @id @default(uuid())
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      Int                    @unique
  featured       Boolean                @default(false)
  summary        String?                @db.Text
  bridgeStatus   PortfolioBridgeStatus  @default(DRAFT) @map("bridge_status")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamp(0)
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  startTime  DateTime @default(now()) @db.Timestamp(0)
  endTime    DateTime? @db.Timestamp(0)
  duration   Int?
  ipHash     String   @db.VarChar(64)
  userAgent  String   @db.Text
  deviceType String?  @db.VarChar(64)
  os         String?  @db.VarChar(64)
  browser    String?  @db.VarChar(64)
  country    String?  @db.VarChar(64)
  city       String?  @db.VarChar(128)
  referrer   String?  @db.Text
  
  events     Event[]
}

model Event {
  id        Int      @id @default(autoincrement())
  sessionId String   @db.Uuid
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(64)
  target    String?  @db.Text
  timestamp DateTime @default(now()) @db.Timestamp(0)
  payload   Json?
}
